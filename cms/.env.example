# Pooled-рядок Neon (Connect → Connection pooling). Для міграцій використовуйте direct-рядок.
DATABASE_URL=
PAYLOAD_SECRET=
# Адреси фронтенду через кому (CORS + CSRF; перша адреса йде в лист зі скиданням пароля)
FRONTEND_URLS=http://localhost:5173
# Лише для seed: перший адмін (створюється, якщо користувачів ще немає)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Скидання пароля поштою (Resend). Без ключа лист лише виводиться в консоль CMS.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=
# Поріг «повільного запиту» в секундах (порожньо = 1)
SLOW_REQUEST_SECONDS=
